{
  "name": "arenacore",
  "private": true,
  "version": "0.1.0",
  "description": "ArenaCore — Esports Tournament & League Operations Platform",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:migrate": "pnpm --filter @arenacore/api db:migrate",
    "db:deploy": "pnpm --filter @arenacore/api db:deploy",
    "db:seed": "pnpm --filter @arenacore/api db:seed",
    "db:reset": "pnpm --filter @arenacore/api db:reset",
    "dev:worker": "pnpm --filter @arenacore/api dev:worker"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
